{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "lib": ["es5", "es6"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "target": "es5",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true
  }
}
